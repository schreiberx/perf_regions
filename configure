#!/bin/bash

# configure script for perf_regions
# Generates config.mk for the traditional Makefile build

set -e

# Default values
PREFIX="/usr/local"
BUILD_TYPE="Release"
ENABLE_MPI="auto"
ENABLE_PAPI="auto"
ENABLE_FORTRAN="auto"
ENABLE_SHARED="yes"
ENABLE_STATIC="no"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored output
print_status() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

print_error() {
    print_status "$RED" "ERROR: $1" >&2
}

print_warning() {
    print_status "$YELLOW" "WARNING: $1"
}

print_info() {
    print_status "$BLUE" "INFO: $1"
}

print_success() {
    print_status "$GREEN" "$1"
}

# Help function
show_help() {
    cat << EOF
\`configure' configures perf_regions to adapt to many kinds of systems.

Usage: $0 [OPTION]... [VAR=VALUE]...

To assign environment variables (e.g., CC, CFLAGS...), specify them as
VAR=VALUE.  See below for descriptions of some of the useful variables.

Defaults for the options are specified in brackets.

Options:
  -h, --help              display this help and exit
      --prefix=PREFIX     install files under PREFIX [/usr/local]
      --enable-debug      build with debugging information and -O0
      --disable-debug     build with optimizations [default]
      --enable-mpi        enable MPI support [default: auto-detect]
      --disable-mpi       disable MPI support
      --enable-papi       enable PAPI support [default: auto-detect]
      --disable-papi      disable PAPI support
      --with-papi=DIR     use the PAPI installation in DIR
      --with-mpi=DIR      use the MPI installation in DIR
      --without-papi      same as --disable-papi
      --without-mpi       same as --disable-mpi
      --enable-fortran    enable Fortran support [default: auto-detect]
      --disable-fortran   disable Fortran support
      --enable-shared     build shared libraries [default]
      --disable-shared    disable shared libraries and enable static libraries
      --enable-static     build static libraries
      --disable-static    do not build static libraries [default]

Environment variables:
  CC          C compiler command
  FC          Fortran compiler command
  CFLAGS      C compiler flags
  FCFLAGS     Fortran compiler flags
  LDFLAGS     linker flags, e.g. -L<lib dir> for libraries in a
              nonstandard directory
  CPPFLAGS    preprocessor flags, e.g. -I<include dir> for headers in a
              nonstandard directory

Use these variables to override the choices made by \`configure' or to help
it to find libraries and programs with nonstandard names/locations.

Report bugs to <https://github.com/schreiberx/perf_regions>.
EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --prefix=*)
            PREFIX="${1#*=}"
            shift
            ;;
        --prefix)
            PREFIX="$2"
            shift 2
            ;;
        --enable-debug|--enable-debug=yes)
            BUILD_TYPE="Debug"
            shift
            ;;
        --disable-debug|--enable-debug=no)
            BUILD_TYPE="Release"
            shift
            ;;
        --enable-mpi|--enable-mpi=yes)
            ENABLE_MPI="ON"
            shift
            ;;
        --disable-mpi|--enable-mpi=no)
            ENABLE_MPI="OFF"
            shift
            ;;
        --enable-papi|--enable-papi=yes)
            ENABLE_PAPI="ON"
            shift
            ;;
        --disable-papi|--enable-papi=no)
            ENABLE_PAPI="OFF"
            shift
            ;;
        --enable-fortran|--enable-fortran=yes)
            ENABLE_FORTRAN="ON"
            shift
            ;;
        --disable-fortran|--enable-fortran=no)
            ENABLE_FORTRAN="OFF"
            shift
            ;;
        --enable-shared|--enable-shared=yes)
            ENABLE_SHARED="yes"
            shift
            ;;
        --disable-shared|--enable-shared=no)
            ENABLE_SHARED="no"
            ENABLE_STATIC="yes"
            shift
            ;;
        --enable-static|--enable-static=yes)
            ENABLE_STATIC="yes"
            shift
            ;;
        --disable-static|--enable-static=no)
            ENABLE_STATIC="no"
            shift
            ;;
        --with-papi=*)
            PAPI_ROOT="${1#*=}"
            ENABLE_PAPI="ON"
            shift
            ;;
        --with-mpi=*)
            MPI_ROOT="${1#*=}"
            ENABLE_MPI="ON"
            shift
            ;;
        --without-papi)
            ENABLE_PAPI="OFF"
            shift
            ;;
        --without-mpi)
            ENABLE_MPI="OFF"
            shift
            ;;
        *=*)
            # Environment variable assignment
            export "$1"
            shift
            ;;
        -*)
            print_warning "Unknown option: $1"
            shift
            ;;
        *)
            print_error "Unknown argument: $1"
            exit 1
            ;;
    esac
done

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to check for dependencies
check_dependencies() {
    print_info "Checking for required dependencies..."
    
    # Check for C compiler
    if ! command_exists "${CC:-gcc}"; then
        print_error "C compiler not found. Please install a C compiler."
        exit 1
    fi
    print_info "Found C compiler: ${CC:-gcc}"
    
    # Check for Fortran compiler
    if [[ "$ENABLE_FORTRAN" == "auto" || "$ENABLE_FORTRAN" == "ON" ]]; then
        if command_exists "${FC:-gfortran}"; then
            print_info "Found Fortran compiler: ${FC:-gfortran}"
            if [[ "$ENABLE_FORTRAN" == "auto" ]]; then
                ENABLE_FORTRAN="ON"
            fi
        else
            if [[ "$ENABLE_FORTRAN" == "ON" ]]; then
                print_error "Fortran compiler not found but Fortran support requested."
                exit 1
            else
                print_info "Fortran compiler not found, disabling Fortran support"
                ENABLE_FORTRAN="OFF"
            fi
        fi
    fi
    
    # Check for make
    if ! command_exists make; then
        print_error "make not found. Please install make."
        exit 1
    fi
    print_info "Found make"
    
    # Check for ar (for static libraries)
    if ! command_exists ar; then
        print_error "ar not found. Please install binutils."
        exit 1
    fi
    print_info "Found ar"
    
    # Check for Python (required for instrumentation)
    if ! command_exists python3; then
        print_error "Python 3 not found. Please install Python 3."
        exit 1
    fi
    print_info "Found Python 3"
}

# Function to auto-detect MPI
check_mpi() {
    if [[ "$ENABLE_MPI" == "OFF" ]]; then
        return
    fi

    if [[ -n "${MPI_ROOT:-}" ]]; then
        if [[ -x "$MPI_ROOT/bin/mpicc" ]]; then
            MPI_CC="$MPI_ROOT/bin/mpicc"
            if [[ -x "$MPI_ROOT/bin/mpif90" ]]; then
                MPI_FC="$MPI_ROOT/bin/mpif90"
            fi
        else
            print_error "mpicc not found below --with-mpi=$MPI_ROOT"
            exit 1
        fi
        ENABLE_MPI="ON"
        return
    fi

    if [[ "$ENABLE_MPI" == "auto" ]]; then
        print_info "Auto-detecting MPI..."
        if command_exists mpicc && { [[ "$ENABLE_FORTRAN" == "OFF" ]] || command_exists mpif90; }; then
            print_info "MPI compilers found, enabling MPI support"
            ENABLE_MPI="ON"
        else
            print_info "MPI compilers not found, disabling MPI support"
            ENABLE_MPI="OFF"
        fi
    elif [[ "$ENABLE_MPI" == "ON" ]]; then
        if ! command_exists "${MPI_CC:-mpicc}"; then
            print_error "MPI requested but mpicc was not found"
            exit 1
        fi
        if [[ "$ENABLE_FORTRAN" != "OFF" ]] && ! command_exists "${MPI_FC:-mpif90}"; then
            print_error "MPI requested but mpif90 was not found"
            exit 1
        fi
    fi
}

# Function to auto-detect PAPI
check_papi() {
    if [[ "$ENABLE_PAPI" == "OFF" ]]; then
        return
    fi

    local papi_found=false

    if [[ -n "${PAPI_ROOT:-}" ]]; then
        PAPI_CFLAGS="-I$PAPI_ROOT/include"
        if [[ -d "$PAPI_ROOT/lib64" ]]; then
            PAPI_LDFLAGS="-L$PAPI_ROOT/lib64 -lpapi"
        else
            PAPI_LDFLAGS="-L$PAPI_ROOT/lib -lpapi"
        fi

        if [[ ! -f "$PAPI_ROOT/include/papi.h" ]]; then
            print_error "papi.h not found below --with-papi=$PAPI_ROOT"
            exit 1
        fi

        ENABLE_PAPI="ON"
        return
    fi

    if [[ -n "$PAPI_CFLAGS$PAPI_LDFLAGS" ]]; then
        ENABLE_PAPI="ON"
        return
    fi

    # Check via pkg-config
    if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists papi; then
        print_info "PAPI found via pkg-config, enabling PAPI support"
        ENABLE_PAPI="ON"
        papi_found=true
        PAPI_CFLAGS=$(pkg-config --cflags papi)
        PAPI_LDFLAGS=$(pkg-config --libs papi)
    fi

    if [[ "$papi_found" == "false" ]]; then
        for dir in /usr /usr/local /opt/papi; do
            local libdir=""
            if [[ -d "$dir/lib64" ]]; then
                libdir="$dir/lib64"
            elif [[ -d "$dir/lib" ]]; then
                libdir="$dir/lib"
            fi

            if [[ -f "$dir/include/papi.h" && -n "$libdir" ]] &&                { [[ -f "$libdir/libpapi.so" ]] || [[ -f "$libdir/libpapi.a" ]]; }; then
                print_info "PAPI found in $dir, enabling PAPI support"
                ENABLE_PAPI="ON"
                papi_found=true
                PAPI_CFLAGS="-I$dir/include"
                PAPI_LDFLAGS="-L$libdir -lpapi"
                break
            fi
        done
    fi

    if [[ "$papi_found" == "false" ]]; then
        if [[ "$ENABLE_PAPI" == "auto" ]]; then
            print_info "PAPI not found, disabling PAPI support"
            ENABLE_PAPI="OFF"
        else
            print_error "PAPI requested but not found"
            exit 1
        fi
    fi
}

# Function to create configuration file
create_config() {
    print_info "Creating configuration file..."
    
    cat > config.mk << EOF
# Configuration file generated by configure script
# This file is sourced by Makefiles

PREFIX=$PREFIX
BUILD_TYPE=$BUILD_TYPE

# MPI compilers (may be overridden by the user)
MPI_CC=${MPI_CC:-mpicc}
MPI_FC=${MPI_FC:-mpif90}

# Feature flags
USE_MPI=$(if [[ "$ENABLE_MPI" == "ON" ]]; then echo 1; else echo 0; fi)
USE_PAPI=$(if [[ "$ENABLE_PAPI" == "ON" ]]; then echo 1; else echo 0; fi)
USE_FORTRAN=$(if [[ "$ENABLE_FORTRAN" == "ON" ]]; then echo 1; else echo 0; fi)
PAPI_CFLAGS=$PAPI_CFLAGS
PAPI_LDFLAGS=$PAPI_LDFLAGS

# Library build options
BUILD_SHARED_LIBS=$(if [[ "$ENABLE_SHARED" == "yes" ]]; then echo 1; else echo 0; fi)
BUILD_STATIC_LIBS=$(if [[ "$ENABLE_STATIC" == "yes" ]]; then echo 1; else echo 0; fi)

# Debug flag used both by the compiler and the generated config header
ifeq (\$(BUILD_TYPE),Debug)
    PERF_DEBUG = 1
    CFLAGS += -fPIC -Wall -g -O0 -DPERF_DEBUG=\$(PERF_DEBUG)
    FCFLAGS += -fPIC -Wall -g -O0 -DPERF_DEBUG=\$(PERF_DEBUG)
else
    PERF_DEBUG = 0
    CFLAGS += -fPIC -Wall -O2 -DPERF_DEBUG=\$(PERF_DEBUG)
    FCFLAGS += -fPIC -Wall -O2 -DPERF_DEBUG=\$(PERF_DEBUG)
endif

# Environment-specific settings
$(if [[ -n "$PAPI_ROOT" ]]; then echo "PAPI_ROOT=$PAPI_ROOT"; fi)
$(if [[ -n "$MPI_ROOT" ]]; then echo "MPI_ROOT=$MPI_ROOT"; fi)

# Export variables for use in sub-makefiles
export PREFIX USE_MPI USE_PAPI USE_FORTRAN PAPI_CFLAGS PAPI_LDFLAGS BUILD_SHARED_LIBS BUILD_STATIC_LIBS MPI_CC MPI_FC PERF_DEBUG
EOF
}

# Function to print configuration summary
print_summary() {
    echo ""
    print_success "Configuration successful!"
    echo ""
    echo "perf_regions configuration summary:"
    echo "=================================="
    echo "  Install prefix: $PREFIX"
    echo "  Build type: $BUILD_TYPE"
    echo "  MPI support: $ENABLE_MPI"
    echo "  PAPI support: $ENABLE_PAPI"
    echo "  Fortran support: $ENABLE_FORTRAN"
    echo "  Build shared libraries: $ENABLE_SHARED"
    echo "  Build static libraries: $ENABLE_STATIC"
    echo ""
    echo "Next steps:"
    echo "  make           # Build the project"
    echo "  make install   # Install the project"
}

# Main execution
main() {
    print_info "Configuring perf_regions..."
    
    check_dependencies
    check_mpi
    check_papi
    
    create_config
    print_summary
}

# Run main function
main "$@"
